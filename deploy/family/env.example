APP_NAME=ALM System
APP_BASE_URL=http://10.0.0.5:3000
APP_BIND=127.0.0.1
APP_PORT=3000
# Set to 1 only after confirming this family runtime is a fresh PostgreSQL install.
ALM_FRESH_POSTGRES_ACKNOWLEDGED=0
APP_USERNAME=family-admin
APP_PASSWORD=replace-with-owner-password
SESSION_SECRET=replace-with-session-secret
DATABASE_URL=postgresql://alm_system:replace-with-postgres-password@postgres:5432/alm_system?schema=public
POSTGRES_DB=alm_system
POSTGRES_USER=alm_system
POSTGRES_PASSWORD=replace-with-postgres-password
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_BOT_USERNAME=replace-with-bot-username
